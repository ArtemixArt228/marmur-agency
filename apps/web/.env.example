# Copy to .env and fill in. Validated by packages/env/src/server.ts.
# drizzle.config.ts also loads this file, so DATABASE_URL lives here.

# Postgres connection string. For the local docker-compose.yml at the repo root:
#   postgresql://postgres:postgres@localhost:5432/marmur_flowers
DATABASE_URL=

# Better Auth. Must be at least 32 characters — generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Backend is "self": Nuxt serves both the app and the API on one origin (port 3001),
# so these are the same host. Change both to the public URL when deploying.
BETTER_AUTH_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001

NODE_ENV=development
