{
  "name": "marmus-flowers",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "typescript": "^6.0.3",
      "@types/node": "^22.20.1",
      "@orpc/server": "^1.14.12",
      "@orpc/client": "^1.14.12",
      "@orpc/openapi": "^1.14.12",
      "@orpc/zod": "^1.14.12",
      "better-auth": "1.6.25"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vp run -r dev",
    "build": "vp run -r build",
    "check-types": "vp run -r check-types",
    "check": "vp check && vp run -r check-types",
    "lint": "vp lint",
    "format": "vp fmt",
    "staged": "vp staged",
    "hooks:setup": "vp config",
    "dev:web": "vp run --filter web dev",
    "db:push": "vp run --filter @marmus-flowers/db db:push",
    "db:studio": "vp run --filter @marmus-flowers/db db:studio",
    "db:generate": "vp run --filter @marmus-flowers/db db:generate",
    "db:migrate": "vp run --filter @marmus-flowers/db db:migrate"
  },
  "dependencies": {
    "@marmus-flowers/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@marmus-flowers/config": "workspace:*",
    "@types/node": "catalog:",
    "rolldown": "1.2.0",
    "typescript": "catalog:",
    "vite-plus": "0.2.6"
  },
  "overrides": {
    "@vue/devtools-api": "^8.2.1",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.6"
  },
  "packageManager": "bun@1.3.14"
}
